<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tv_alert_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 alerts"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_console"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Alerts section (top half) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" ⚠ ACTIVE ALERTS"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:background="@color/bg_elevated"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"/>

    <ScrollView
        android:id="@+id/scroll_alerts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_primary">

        <LinearLayout
            android:id="@+id/ll_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp"/>
    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default"/>

    <!-- Console section (bottom half) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" > DECISION CONSOLE"
        android:textColor="@color/accent_cyan"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:background="@color/bg_elevated"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"/>

    <ScrollView
        android:id="@+id/scroll_console"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050A0F">

        <LinearLayout
            android:id="@+id/ll_console"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>
    </ScrollView>

</LinearLayout>
